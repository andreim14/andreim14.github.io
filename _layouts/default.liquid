<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- assign t = page.title -%}
    {%- if page.inline -%}{%- assign t = 'News' -%}{%- endif -%}
    {%- if page.type == 'year' -%}{%- assign t = page.date | date: '%Y' | prepend: 'Writing in ' -%}{%- elsif page.type == 'tag' -%}{%- assign t = page.title | prepend: 'Posts tagged ' -%}{%- elsif page.type == 'category' -%}{%- assign t = page.title | prepend: 'Posts in ' -%}{%- endif -%}
    {%- if page.url == '/' -%}
      {%- assign doc_title = 'Andrei Stefan Bejgu · Senior AI Applied Scientist' -%}
    {%- else -%}
      {%- assign doc_title = t | default: 'Andrei Stefan Bejgu' | append: ' · Andrei Stefan Bejgu' -%}
    {%- endif -%}
    {%- assign doc_desc = page.description | default: site.description | strip_html | strip_newlines | truncate: 200 -%}
    {%- assign doc_img = '/assets/img/og-card.png' -%}
    {%- if page.thumbnail -%}
      {%- assign thumb_path = page.thumbnail | prepend: '/' | replace: '//', '/' -%}
      {%- assign thumb_hit = site.static_files | where: 'path', thumb_path | first -%}
      {%- if thumb_hit -%}{%- assign doc_img = thumb_path -%}{%- endif -%}
    {%- endif -%}
    {%- assign doc_img = doc_img | absolute_url -%}
    <title>{{ doc_title }}</title>
    <meta name="description" content="{{ doc_desc }}">
    <meta name="author" content="Andrei Stefan Bejgu">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:type" content="{% if page.layout == 'post' %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ doc_title }}">
    <meta property="og:description" content="{{ doc_desc }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ doc_img }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f4f0e6" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#12100c" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%226%22 fill=%22%2316130e%22/><rect x=%225%22 y=%2218%22 width=%2222%22 height=%228%22 fill=%22%23ffcb3d%22/><text x=%2216%22 y=%2223%22 font-family=%22Georgia%22 font-size=%2219%22 text-anchor=%22middle%22 fill=%22%23f4f0e6%22>b</text></svg>">
    {% feed_meta %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:ital,wght@0,400..700;1,400..600&family=JetBrains+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url }}?v={{ site.time | date: '%s' }}">
    <script>
      // Theme and JS flags before first paint: no flash, and hidden-until-revealed states only apply when JS runs.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null; try { t = localStorage.getItem('theme'); } catch (e) {}
        d.dataset.theme = t || 'light';
      })();
    </script>
    {%- if site.enable_google_analytics and site.google_analytics %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', '{{ site.google_analytics }}');
    </script>
    {%- endif %}
    {%- if page.url == '/' %}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"Person","name":"Andrei Stefan Bejgu","jobTitle":"Senior AI Applied Scientist","worksFor":{"@type":"Organization","name":"Syllotips"},"alumniOf":"Sapienza University of Rome","url":"{{ site.url }}","sameAs":["https://github.com/andreim14","https://www.linkedin.com/in/andrei-stefan-bejgu/","https://scholar.google.com/citations?user=N_eHzKAAAAAJ"]}
    </script>
    {%- endif %}
  </head>
  <body class="page-{{ page.layout | default: 'page' }}">
    <a class="skip" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>

    <header class="topbar">
      <a class="brand" href="{{ '/' | relative_url }}" aria-label="Home">
        <span class="brand-mark">b</span><span class="brand-name">Andrei Stefan Bejgu</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="{{ '/#work' | relative_url }}">work</a>
        <a href="{{ '/publications/' | relative_url }}" {% if page.url contains '/publications' %}aria-current="page"{% endif %}>papers</a>
        <a href="{{ '/blog/' | relative_url }}" {% if page.url contains '/blog' %}aria-current="page"{% endif %}>writing</a>
        <a href="{{ '/assets/pdf/cv.pdf' | relative_url }}">cv</a>
        <button class="cmdk-btn" type="button" data-cmdk-open aria-label="Open command menu"><kbd>⌘K</kbd></button>
        <button class="theme-btn" type="button" data-theme-toggle aria-label="Toggle dark mode">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9A7 7 0 0 1 12 3z" fill="currentColor"/></svg>
        </button>
      </nav>
    </header>

    <main id="main">
      {{ content }}
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <p class="footer-big">Building agents that check their work?<br><a class="mail" href="mailto:stefan.bejgu@gmail.com" data-copy="stefan.bejgu@gmail.com">stefan.bejgu@gmail.com</a></p>
        <ul class="footer-links">
          <li><a href="https://github.com/andreim14">GitHub</a></li>
          <li><a href="https://scholar.google.com/citations?user=N_eHzKAAAAAJ">Scholar</a></li>
          <li><a href="https://www.linkedin.com/in/andrei-stefan-bejgu/">LinkedIn</a></li>
          <li><a href="{{ '/feed.xml' | relative_url }}">RSS</a></li>
          <li><a href="{{ '/assets/pdf/cv.pdf' | relative_url }}">CV (PDF)</a></li>
        </ul>
        <p class="footer-meta">Rome, Italy · © {{ site.time | date: '%Y' }} Andrei Stefan Bejgu · Hand-built, no template.</p>
      </div>
    </footer>

    <dialog class="cmdk" data-cmdk aria-label="Command menu">
      <div class="cmdk-box">
        <input class="cmdk-input" type="text" placeholder="Jump to a section, paper or post…" aria-label="Search" autocomplete="off" spellcheck="false">
        <ul class="cmdk-list" role="listbox"></ul>
        <p class="cmdk-hint"><kbd>↑</kbd><kbd>↓</kbd> move · <kbd>↵</kbd> open · <kbd>esc</kbd> close</p>
      </div>
    </dialog>
    <script id="cmdk-data" type="application/json">
      [
        {"t":"Home","k":"section","u":"{{ '/' | relative_url }}"},
        {"t":"What I build at Syllotips","k":"section","u":"{{ '/#work' | relative_url }}"},
        {"t":"Career trace","k":"section","u":"{{ '/#trace' | relative_url }}"},
        {"t":"Research","k":"section","u":"{{ '/#research' | relative_url }}"},
        {"t":"Open source","k":"section","u":"{{ '/#code' | relative_url }}"},
        {"t":"All publications","k":"page","u":"{{ '/publications/' | relative_url }}"},
        {"t":"Writing","k":"page","u":"{{ '/blog/' | relative_url }}"},
        {"t":"CV (PDF)","k":"file","u":"{{ '/assets/pdf/cv.pdf' | relative_url }}"},
        {"t":"Copy email address","k":"action","a":"copy-email"},
        {"t":"Toggle dark mode","k":"action","a":"theme"},
        {"t":"GitHub","k":"link","u":"https://github.com/andreim14"},
        {"t":"Google Scholar","k":"link","u":"https://scholar.google.com/citations?user=N_eHzKAAAAAJ"},
        {"t":"LinkedIn","k":"link","u":"https://www.linkedin.com/in/andrei-stefan-bejgu/"}
        {%- for post in site.posts -%},
        {"t":{{ post.title | jsonify }},"k":"post","u":"{{ post.url | relative_url }}"}
        {%- endfor %}
      ]
    </script>
    <div class="toast" role="status" aria-live="polite"></div>
    <script src="{{ '/assets/js/site.js' | relative_url }}?v={{ site.time | date: '%s' }}" defer></script>
  </body>
</html>
