<div class="pub" id="{{ entry.key }}">
  <p class="pub-title">{{ entry.title }}</p>
  <p class="pub-authors">
    {%- for author in entry.author_array -%}
      {%- assign last = author.last | regex_replace: '[*∗]', '' -%}
      {%- assign star = '' -%}{%- if author.last contains '*' -%}{%- assign star = '*' -%}{%- endif -%}
      {%- if site.scholar.last_name contains last -%}<strong>{{ author.first | slice: 0 }}. S. {{ last }}{{ star }}</strong>{%- else -%}{{ author.first | slice: 0 }}. {{ last }}{{ star }}{%- endif -%}
      {%- unless forloop.last -%}, {% endunless -%}
    {%- endfor -%}
  </p>
  <p class="pub-meta">
    <span class="venue">{{ entry.journal | default: entry.booktitle }}</span>
    {% if entry.html or entry.url %}<a href="{{ entry.html | default: entry.url }}">paper</a>{% elsif entry.pdf %}<a href="{{ entry.pdf }}">pdf</a>{% endif %}
    {% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% endif %}
    {% if entry.code %}<a href="{{ entry.code }}">code</a>{% endif %}
    {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}">doi</a>{% endif %}
  </p>
</div>
