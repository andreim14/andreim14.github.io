---
layout: default
---
{%- assign words = content | strip_html | number_of_words -%}
{%- assign minutes = words | divided_by: 220 | plus: 1 -%}
<article class="doc post">
  <header class="doc-head">
    <p class="eyebrow">
      {% if page.inline %}news{% else %}<a href="{{ '/blog/' | relative_url }}">writing</a>{% endif %}
      · <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%b %-d, %Y' }}</time>
      {% unless page.inline %}· {{ minutes }} min read{% endunless %}
    </p>
    {% if page.title %}<h1 class="doc-title">{{ page.title }}</h1>{% endif %}
    {% if page.description %}<p class="doc-lede">{{ page.description }}</p>{% endif %}
    {% if page.tags.size > 0 %}
    <p class="tags">{% for tag in page.tags %}<a href="{{ '/blog/tag/' | append: tag | slugify | append: '/' | relative_url }}">#{{ tag }}</a>{% endfor %}</p>
    {% endif %}
  </header>
  <div class="read-progress" aria-hidden="true"><span></span></div>
  <div class="doc-body prose">
    {{ content }}
  </div>
  {% unless page.inline %}
  <nav class="post-nav" aria-label="More posts">
    {% if page.previous %}<a href="{{ page.previous.url | relative_url }}"><span>older</span>{{ page.previous.title }}</a>{% endif %}
    {% if page.next %}<a class="next" href="{{ page.next.url | relative_url }}"><span>newer</span>{{ page.next.title }}</a>{% endif %}
  </nav>
  {% endunless %}
</article>
