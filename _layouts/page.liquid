---
layout: default
---
<article class="doc">
  <header class="doc-head">
    {% if page.eyebrow %}<p class="eyebrow">{{ page.eyebrow }}</p>{% endif %}
    <h1 class="doc-title">{{ page.title }}</h1>
    {% if page.description %}<p class="doc-lede">{{ page.description }}</p>{% endif %}
  </header>
  <div class="doc-body prose">
    {{ content }}
  </div>
</article>
