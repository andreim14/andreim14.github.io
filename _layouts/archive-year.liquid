---
layout: default
---
<article class="doc">
  <header class="doc-head">
    <p class="eyebrow"><a href="{{ '/blog/' | relative_url }}">writing</a> · year</p>
    <h1 class="doc-title">{% if page.type == 'year' %}{{ page.date | date: '%Y' }}{% else %}#{{ page.title }}{% endif %}</h1>
  </header>
  {% include post-list.liquid posts=page.posts %}
</article>
