{% assign repo_info = site.data.repositories.repo_details[include.repository] %}
<a class="repo-card" href="https://github.com/{{ include.repository }}">
  <span class="repo-card-name">{{ include.repository }}</span>
  {% if repo_info.description %}<span class="repo-card-desc">{{ repo_info.description }}</span>{% endif %}
  <span class="repo-card-meta">{% if repo_info.language %}{{ repo_info.language }}{% endif %}{% if repo_info.stars %} · ★ {{ repo_info.stars }}{% endif %}</span>
</a>
