<ol class="post-list">
  {%- for post in include.posts -%}
  <li>
    <a href="{{ post.url | relative_url }}">
      <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%b %Y' }}</time>
      <span class="pl-title">{{ post.title }}</span>
      {% if post.description %}<span class="pl-desc">{{ post.description | strip_html | truncate: 170 }}</span>{% endif %}
    </a>
  </li>
  {%- endfor -%}
</ol>
